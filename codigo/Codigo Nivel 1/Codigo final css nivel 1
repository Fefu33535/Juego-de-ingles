/* =========================================================================
   1. RESET GENERAL Y CONFIGURACIÓN BASE DEL DOCUMENTO
   ========================================================= */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box; /* Incluye bordes y padding dentro del tamaño total */
    user-select: none;      /* Evita la selección accidental de texto en el juego */
}

html, body {
    width: 100vw;
    height: 100vh;
    overflow: hidden;       /* Oculta barras de desplazamiento navegador */
    background-color: #0b0b0b; /* Fondo oscuro elegante estilo escritorio */
    display: flex;
    justify-content: center;
    align-items: center;
}

/* =========================================================================
   2. CONTENEDOR RESPONSIVE VIEWPORT (Mantiene relación de aspecto 16:9 fija)
   Esto garantiza que las hitboxes porcentuales nunca se descalibren en 
   ninguna pantalla o dispositivo (PC, tablets, notebooks).
   ========================================================= */
#game-viewport {
    position: relative;
    width: 100vw;
    height: 56.25vw; /* Relación de aspecto 16:9 exacta basada en el ancho (16/9 = 0.5625) */
    max-height: 100vh;
    max-width: 177.78vh; /* Relación inversa para pantallas muy altas (16/9) */
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.9); /* Sombra elegante alrededor del juego */
    overflow: hidden;
    background-color: #000;
}

/* =========================================================================
   3. GESTIÓN DE PANTALLAS (VISIBILIDAD)
   ========================================================= */
.screen {
    display: none;       /* Por defecto todas las pantallas están ocultas */
    position: absolute;  /* Se posicionan de forma absoluta dentro del viewport */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.screen.active {
    display: block;      /* Muestra únicamente la pantalla que posea la clase 'active' */
}

.bg-fullscreen {
    width: 100%;
    height: 100%;
    object-fit: fill;    /* Ajusta la imagen de fondo para cubrir todo el viewport adaptable */
    display: block;
    pointer-events: none; /* Evita que la imagen interfiera con los clics de las hitboxes */
}

/* =========================================================================
   4. CONFIGURACIÓN BASE DE LAS HITBOXES (BOTONES INVISIBLES)
   ========================================================= */
.hitbox {
    position: absolute;
    background: rgba(0, 0, 0, 0); /* Totalmente transparentes por defecto */
    border: none;
    cursor: pointer;
    z-index: 20;                  /* Asegura que estén por encima de la imagen de fondo */
    outline: none;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background-color 0.15s ease; /* Transición suave al interactuar */
}

/* Efecto visual al pasar el cursor (útil para testeo y depuración de coordenadas) */
.hitbox:hover {
    background-color: rgba(255, 255, 255, 0.12); 
}

/* Efecto visual al hacer clic */
.hitbox:active {
    background-color: rgba(255, 255, 255, 0.25);
}

.btn-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
}

